# OpenCineAgent environment (copy to .env). Every setting in opencine/core/config.py can be set here.

# ComfyUI
OPENCINE_COMFYUI_HOST=127.0.0.1
OPENCINE_COMFYUI_PORT=8188
OPENCINE_COMFYUI_TIMEOUT=3600
# Reject a partially started ComfyUI (set to ~95% of your normal node count, 0 disables)
OPENCINE_COMFYUI_MIN_NODES=0

# Ollama (scriptwriter LLM and QC vision model)
OPENCINE_OLLAMA_URL=http://127.0.0.1:11434
OPENCINE_LLM_SCRIPTWRITER_MODEL=qwen3:8b
OPENCINE_VLM_REVIEWER_MODEL=qwen2.5vl:7b

# Format
OPENCINE_DIALOGUE_LANGUAGE=English
OPENCINE_VIDEO_WIDTH=1024
OPENCINE_VIDEO_HEIGHT=576
OPENCINE_KEYFRAME_WIDTH=1536
OPENCINE_KEYFRAME_HEIGHT=864

# --- MiniMax H3, official checkpoint + 4-step turbo LoRA (default) ---
OPENCINE_H3_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
OPENCINE_H3_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors
OPENCINE_H3_STEPS=4
OPENCINE_H3_SAMPLER=res_multistep
OPENCINE_H3_REF_IMAGE_SIZE=max
# H3SLAAttention from plaguekind-nodes (faster; block 32 crashed some Triton builds -> try 64)
OPENCINE_H3_SLA=false

# --- Distilled H3 fine-tune example (no turbo LoRA, 8 steps, euler) ---
# OPENCINE_H3_UNET=h3ErosMax_beta5_fp8.safetensors
# OPENCINE_H3_TURBO_LORA=
# OPENCINE_H3_STEPS=8
# OPENCINE_H3_SAMPLER=euler

# --- Krea 2 ---
OPENCINE_KREA2_UNET=krea2_turbo_fp8_scaled.safetensors
OPENCINE_KREA2_STEPS=8
# Two-pass recipe for Krea 2 mixes (er_sde 7 -> x2 latent -> dpmpp_2m_sde 9)
OPENCINE_KREA2_HIRES_PASS=false

# QC
OPENCINE_MAX_QC_RETRIES=2
OPENCINE_DIALOGUE_MATCH_THRESHOLD=0.55
OPENCINE_WHISPER_MODEL=medium

# Upscale: none | lanczos | clearreality
OPENCINE_UPSCALE_MODE=lanczos
# OPENCINE_UPSCALE_MODE=clearreality
# OPENCINE_UPSCALE_MODEL_PATH=/path/to/ComfyUI/models/upscale_models/4x-ClearRealityV1.pth
# OPENCINE_UPSCALE_PYTHON=/path/to/ComfyUI/venv/bin/python

# Music: none | file (--music) | minimax (MiniMax Music 3)
OPENCINE_MUSIC_MODE=none
OPENCINE_TARGET_LUFS=-14.0
