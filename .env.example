# OpenCineAgent Environment Variables

# ComfyUI Headless Service
OPENCINE_COMFYUI_HOST=127.0.0.1
OPENCINE_COMFYUI_PORT=8188
OPENCINE_COMFYUI_TIMEOUT=300.0
OPENCINE_COMFYUI_SIMULATED=false

# Ollama Local Service
OPENCINE_OLLAMA_URL=http://127.0.0.1:11434
OPENCINE_LLM_SCRIPTWRITER_MODEL=qwen3:8b
OPENCINE_VLM_REVIEWER_MODEL=qwen2.5-vl:7b
OPENCINE_OLLAMA_TIMEOUT=120.0

# QC & Healing Parameters
OPENCINE_MAX_QC_RETRIES=3
OPENCINE_IDENTITY_DRIFT_THRESHOLD=0.28
OPENCINE_STRICT_HAND_VERIFICATION=true

# Video & Upscaling
OPENCINE_VIDEO_ENGINE=wan2.1
OPENCINE_DEFAULT_FPS=24
OPENCINE_UPSCALE_TARGET_FPS=60
OPENCINE_ENABLE_RIFE=true
OPENCINE_ENABLE_UPSCALER=true

# Audio & Sidechain Ducking
OPENCINE_DUCKING_ATTENUATION_DB=-12.0
OPENCINE_DUCKING_ATTACK_MS=150
OPENCINE_DUCKING_RELEASE_MS=400
OPENCINE_VOICE_SAMPLE_RATE=24000
OPENCINE_TARGET_LUFS=-14.0
